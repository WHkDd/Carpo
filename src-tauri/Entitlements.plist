<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TODO(release): once we ship under a real Apple Developer ID, sign
  libpdfium.dylib explicitly and remove this entitlement. It's only
  here so the ad-hoc-signed build can load the third-party
  libpdfium.dylib bundled in Frameworks/. Granting it disables dylib
  signature validation for the entire process, which is a strictly
  larger attack surface than necessary for a notarized build.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
